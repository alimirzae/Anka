@inherits LayoutComponentBase
@implements IDisposable
@inject UiText UI
@inject IJSRuntime Js

<div class="top-strip"><span>✦ @UI.T("banner")</span><span class="top-strip-en">ANKA DIGITAL READING EXPERIENCE</span></div>
<header class="site-header" dir="@UI.Direction">
 <div class="header-inner">
  <a class="brand" href="/" aria-label="Anka home"><img src="/anka-bird.svg" alt="Anka Kuşu" class="brand-phoenix" /><span>ANKA<small>@UI.T("brandSub")</small></span></a>
  <nav class="header-nav" aria-label="Main navigation">
   <a href="/">@UI.T("home")</a><a href="/#discover">@UI.T("discover")</a><a href="/#discover">@UI.T("freeBooks")</a><a href="/upload">@UI.T("myLibrary")</a>
  </nav>
  <div class="headtools">
   <label class="ui-language" for="uiLanguage">🌐 <span>@UI.T("uiLanguage")</span>
    <select id="uiLanguage" value="@UI.Language" @onchange="LanguageChanged" aria-label="@UI.T("uiLanguage")">
     <option value="fa">فارسی</option><option value="en">English</option><option value="tr">Türkçe</option>
     <option value="az-Latn">Azərbaycanca</option><option value="az-Arab">آذربایجان تورکجه‌سی</option>
    </select>
   </label>
   <a class="header-search" href="/#shelf" aria-label="@UI.T("search")">⌕ <span>@UI.T("search")</span></a>
   <button class="theme-switch" title="@UI.T("theme")" @onclick="ToggleTheme">◐</button>
   <a href="/upload" class="header-upload"><span>＋</span> @UI.T("addBook")</a>
  </div>
 </div>
</header>
<main dir="@UI.Direction">@Body</main>
<footer class="site-footer" dir="@UI.Direction">
 <div><strong class="footer-mark"><img src="/anka-bird.svg" alt="" class="footer-phoenix"/> ANKA</strong><p>@UI.T("tagline")</p></div>
 <div><b>@UI.T("myLibrary")</b><a href="/">@UI.T("home")</a><a href="/#discover">@UI.T("discover")</a><a href="/upload">@UI.T("uploadTitle")</a></div>
 <div><b>@UI.T("footerAbout")</b><span>Blazor Server · SQLite · EPUB</span><span>@UI.T("noAccount")</span></div>
</footer>
@code {
 protected override void OnInitialized() => UI.Changed += Refresh;
 private void Refresh() => _ = InvokeAsync(StateHasChanged);
 protected override async Task OnAfterRenderAsync(bool firstRender) {
  if(firstRender) {
   try { UI.Set(await Js.InvokeAsync<string>("ankaSite.getLanguage")); }
   catch(JSException) { }
  }
 }
 private async Task LanguageChanged(ChangeEventArgs e) {
  var language=e.Value?.ToString()??"fa";
  UI.Set(language);
  await Js.InvokeVoidAsync("ankaSite.setLanguage",UI.Language);
 }
 private Task ToggleTheme() => Js.InvokeVoidAsync("ankaReader.toggleTheme").AsTask();
 public void Dispose() => UI.Changed -= Refresh;
}