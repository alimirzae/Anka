@page "/upload"
@inject IJSRuntime Js
@inject NavigationManager Nav
<div class="intro"><p class="eyebrow">ANKA COLLECTION</p><h1>افزودن کتاب EPUB</h1></div>
<div class="form">
 <label for="uploadFile">فایل EPUB</label><input id="uploadFile" type="file" accept=".epub,application/epub+zip" />
 <label for="bookTitle">عنوان (اختیاری)</label><input id="bookTitle" @bind="title" maxlength="500" />
 <label for="bookAuthor">نویسنده (اختیاری)</label><input id="bookAuthor" @bind="author" maxlength="300" />
 <label for="bookLanguage">زبان</label><select id="bookLanguage" @bind="language"><option value="fa">فارسی</option><option value="az">Azərbaycan</option><option value="az-Arab">آذربایجان تورکجه‌سی</option><option value="tr">Türkçe</option></select>
 <button class="primary" disabled="@busy" @onclick="UploadBook">افزودن به کتابخانه</button>
 <p role="status">@status</p>
</div>
@code {
 private string title="",author="",language="fa",status="";
 private bool busy;
 private async Task UploadBook(){
  busy=true;status="در حال بارگذاری...";
  try {
   var message=await Js.InvokeAsync<string>("ankaReader.upload",title,author,language);
   if(message=="ok")Nav.NavigateTo("/");
   else status=message;
  }catch(JSException ex){status="بارگذاری ناموفق بود: "+ex.Message;}
  finally{busy=false;}
 }
}