@page "/upload"
@implements IDisposable
@inject UiText L
@inject IJSRuntime Js
@inject NavigationManager Nav

<div class="intro">
 <p class="eyebrow">ANKA COLLECTION</p>
 <h1>@L.T("uploadTitle")</h1>
 <p>@L.T("uploadHelp")</p>
</div>
<div class="form">
 <label for="uploadFile">@L.T("file")</label>
 <input id="uploadFile" type="file" accept=".epub,application/epub+zip" />
 <label for="bookTitle">@L.T("titleOptional")</label>
 <input id="bookTitle" @bind="title" maxlength="500" />
 <label for="bookAuthor">@L.T("authorOptional")</label>
 <input id="bookAuthor" @bind="author" maxlength="300" />
 <label for="bookLanguage">@L.T("languageOfBook")</label>
 <select id="bookLanguage" @bind="language">
  <option value="fa">فارسی</option>
  <option value="az-Latn">Az.Turkce</option>
  <option value="az-Arab">تورکجه</option>
  <option value="tr">Türkçe</option>
  <option value="en">English</option>
 </select>
 <label for="rightsDeclaration">@L.T("rightsDeclaration")</label>
 <textarea id="rightsDeclaration" @bind="rights" rows="4" maxlength="2000" placeholder="@L.T("rightsHelp")"></textarea>
 <p class="account-note">@L.T("uploadReviewNotice")</p>
 <button class="primary" disabled="@busy" @onclick="UploadBook">@L.T("uploadSubmit")</button>
 <p role="status">@status</p>
</div>
@code {
 private string title="",author="",language="az-Arab",rights="",status="";
 private bool busy;
 protected override void OnInitialized()=>L.Changed+=Updated;
 private void Updated()=>_=InvokeAsync(StateHasChanged);
 private async Task UploadBook()
 {
  busy=true;status=L.T("uploading");
  try
  {
   var result=await Js.InvokeAsync<string>("ankaReader.upload",title,author,language,rights);
   if(result=="ok"){status=L.T("uploadReviewNotice");busy=false;}
   else status=result=="ابتدا یک فایل EPUB انتخاب کنید."?L.T("firstSelect"):L.T("uploadFailed")+": "+result;
  }
  catch(JSException ex){status=L.T("uploadFailed")+": "+ex.Message;}
  finally{busy=false;}
 }
 public void Dispose()=>L.Changed-=Updated;
}