@page "/preview/{Slug}"
@implements IDisposable
@inject UiText L
@inject NavigationManager Nav
@inject CatalogImporter Importer

<div class="preview-nav"><a href="/">→ @L.T("back")</a><span>ANKA / CLASSICS / @book?.Title</span></div>
@if(book is null)
{
 <div class="library-empty"><h1>@L.T("fileMissing")</h1><a href="/">@L.T("home")</a></div>
}
else
{
 <section class="detail-layout">
  <div class="detail-book">
   <div class="book-cover detail-cover @("cover-"+book.Slug)">
    <span class="cover-imprint">ANKA · CLASSICS</span><span class="cover-ornament">❧</span>
    <strong>@book.Title</strong><small>@book.Author</small><span class="cover-foot">TÜRK EDEBİYATI</span>
   </div>
   <a class="source-link" href="@book.SourceUrl" target="_blank" rel="noopener noreferrer">@L.T("openSource") ↗</a>
  </div>
  <div class="detail-content">
   <span class="tag">@L.T("publicDomain")</span>
   <h1 dir="ltr">@book.Title</h1>
   <p class="detail-author">@L.T("author"): @book.Author</p>
   <p>@L.T("summary_"+book.Slug)</p>
   <div class="book-stats"><span>◈ @L.T("originalLanguage")</span><span>◈ EPUB</span><span>◈ @L.T("noAuth")</span></div>
   <div class="preview-tabs" role="group" aria-label="@L.T("readingLanguage")">
    <button class="@(mode=="tr"?"active":"")" aria-pressed="@(mode=="tr")" @onclick='() => SetMode("tr")'>Türkçe</button>
    <button class="@(mode=="az"?"active":"")" aria-pressed="@(mode=="az")" @onclick='() => SetMode("az")'>Azərbaycan (Latin)</button>
    <button class="@(mode=="arab"?"active":"")" aria-pressed="@(mode=="arab")" @onclick='() => SetMode("arab")'>آذربایجان تورکجه‌سی</button>
   </div>
   <div class="language-preview" dir="@(mode=="arab"?"rtl":"ltr")" lang="@(mode=="tr"?"tr":"az")">
    <span class="reading-caption">@L.T("languagePreview")</span>
    <p>@(mode=="tr"?book.PreviewTr:mode=="az"?book.PreviewAz:book.PreviewArabic)</p>
   </div>
   <p class="preview-disclaimer">@L.T("previewNote")</p>
   <div class="detail-actions">
    <button class="btn btn-dark" disabled="@busy" @onclick="OpenFullBook">@(busy?L.T("preparing"):L.T("readFull")) ←</button>
    <a class="btn btn-outline" href="/upload">@L.T("addBook")</a>
   </div>
   @if(!string.IsNullOrWhiteSpace(error)){<p class="notice" role="alert">@error</p>}
  </div>
 </section>
}
@code{
 [Parameter] public string Slug{get;set;}="";
 private CatalogBook? book;
 private string mode="tr";
 private bool busy;
 private string? error;
 protected override void OnInitialized()=>L.Changed+=RefreshUi;
 private void RefreshUi()=>_=InvokeAsync(StateHasChanged);
 protected override void OnParametersSet()=>book=SampleCatalog.Find(Slug);
 private void SetMode(string value)=>mode=value;
 private async Task OpenFullBook()
 {
  if(book is null)return;
  busy=true;error=null;
  try{var id=await Importer.ImportAsync(book);Nav.NavigateTo("/read/"+id);}
  catch(Exception){error=L.T("downloadError");}
  finally{busy=false;}
 }
 public void Dispose()=>L.Changed-=RefreshUi;
}