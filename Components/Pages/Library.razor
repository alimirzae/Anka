@inject UiText UI
@implements IDisposable
@page "/"
@using Microsoft.Data.Sqlite
@using Anka
@inject NavigationManager Nav
@inject IWebHostEnvironment HostEnvironment
@inject CatalogImporter Importer

<section class="showcase">
 <div class="showcase-copy">
  <span class="pill">@UI.T("brandSub") <span class="pill-dot"></span> ANKA READER</span>
  <h1>@UI.T("heroHeading")</h1>
  <p>@UI.T("heroDescription")</p>
  <div class="hero-buttons">
   <a class="btn btn-light" href="#discover">@UI.T("explore") <span aria-hidden="true">←</span></a>
   <a class="btn btn-ghost" href="/upload">+ @UI.T("uploadTitle")</a>
  </div>
  <div class="hero-facts"><span>◉ @UI.T("noLogin")</span><span>◉ @UI.T("onlineRead")</span></div>
 </div>
 <div class="hero-art" aria-hidden="true">
  <div class="art-glow"></div><div class="floating-book art-book-one"><span>ANKA CLASSICS</span><b>KAŞAĞI</b><small>ÖMER SEYFETTİN</small><i>✦</i></div>
  <div class="floating-book art-book-two"><span>ANKA COLLECTION</span><b>YALNIZ<br/>EFE</b><small>TÜRK EDEBİYATI</small><i>✺</i></div>
  <div class="art-medallion">۵ <small>اثر برگزیده</small></div>
 </div>
</section>

<section class="benefit-strip" aria-label="امکانات آنکا">
 <div><span class="feature-symbol">▣</span><span><strong>@UI.T("personalShelf")</strong><small>@UI.T("personalShelfDetail")</small></span></div>
 <div><span class="feature-symbol">☼</span><span><strong>@UI.T("dayNight")</strong><small>@UI.T("dayNightDetail")</small></span></div>
 <div><span class="feature-symbol">文</span><span><strong>@UI.T("threeScripts")</strong><small>@UI.T("threeScriptsDetail")</small></span></div>
 <div><span class="feature-symbol">☷</span><span><strong>@UI.T("responsive")</strong><small>@UI.T("responsiveDetail")</small></span></div>
</section>

<section class="catalog-section" id="discover">
 <div class="section-heading"><div><span class="eyebrow">EDITOR'S CHOICE</span><h2>@UI.T("turkishClassics")</h2><p>@UI.T("fiveStories")</p></div><span class="tag">@UI.T("featured")</span></div>
 <div class="catalog-tabs"><button class="selected">@UI.T("all")</button><button @onclick='() => filter="داستان کوتاه"'>@UI.T("shortStory")</button><button @onclick='() => filter="تاریخی"'>@UI.T("historical")</button><button @onclick='() => filter="ماجراجویی"'>@UI.T("adventure")</button><button @onclick='() => filter=""'>@UI.T("all")</button></div>
 <div class="featured-books">
 @foreach(var book in SampleCatalog.Items.Where(b=>string.IsNullOrEmpty(filter)||b.Category==filter))
 {
  <article class="feature-card" @key="book.Slug">
   <a href="@("/preview/"+book.Slug)" class="book-cover @("cover-"+book.Slug)" aria-label="@book.Title">
    <span class="cover-imprint">ANKA · CLASSICS</span><span class="cover-ornament">✦</span>
    <strong>@book.Title</strong><small>@book.Author</small><span class="cover-foot">TÜRK EDEBİYATI</span>
   </a>
   <div class="feature-details"><div class="book-type">@UI.T("booksCategory")</div><a class="feature-name" href="@("/preview/"+book.Slug)">@book.Title</a><p>@book.Summary</p>
   <div class="book-options"><span>TR</span><span>AZ</span><span>آذ</span></div>
   <a class="view-book" href="@("/preview/"+book.Slug)">@UI.T("previewThree") <span>←</span></a></div>
  </article>
 }
 </div>
 <p class="source-note">متن کامل ترکی از ویکی‌نبشته دریافت می‌شود. نسخه‌های آذربایجانی فعلاً پیش‌نمایش ترجمه‌اند، نه ترجمه کامل کتاب. <a href="https://tr.wikisource.org/wiki/Ki%C5%9Fi:%C3%96mer_Seyfettin" target="_blank" rel="noopener noreferrer">منبع آثار</a></p>
</section>

<section class="personal-section">
 <div class="section-heading"><div><span class="eyebrow">YOUR SHELF</span><h2>@UI.T("myLibrary")</h2><p>@UI.T("shelfDescription")</p></div><a class="btn btn-dark" href="/upload">+ بارگذاری EPUB</a></div>
 <div class="library-filter"><label for="librarySearch">⌕</label><input id="librarySearch" @bind="search" @bind:event="oninput" placeholder="@UI.T("searchShelf")" /><span>@VisibleBooks.Count کتاب</span></div>
 @if(error is not null){<p class="notice">@error</p>}
 <div class="my-library-grid">
 @if(VisibleBooks.Count == 0){<div class="library-empty"><div>▤</div><strong>@UI.T("shelfEmpty")</strong><p>@UI.T("shelfEmptySub")</p></div>}
 @foreach(var b in VisibleBooks)
 {
  <button class="library-book" @key="b.Id" @onclick="() => OpenBook(b.Id)">
    <div class="small-cover"><span>ANKA</span><strong>@b.Title</strong><small>@b.Author</small></div>
    <strong>@b.Title</strong><small>@b.Author · @b.Language</small><span class="library-open">@UI.T("continue") ←</span>
  </button>
 }
 </div>
</section>
@code {
 protected override void OnInitialized(){ UI.Changed += Refresh; }
 private void Refresh() => _ = InvokeAsync(StateHasChanged);
 public void Dispose() => UI.Changed -= Refresh;

 private void OpenBook(string id) => Nav.NavigateTo("/read/" + id);
 private List<BookListItem> books = new();
 private string search="", filter="";
 private string? error;
 private List<BookListItem> VisibleBooks => books.Where(b => (b.Title+" "+b.Author).Contains(search,StringComparison.OrdinalIgnoreCase)).ToList();
 protected override async Task OnInitializedAsync(){
  try{
    var path=Path.Combine(HostEnvironment.ContentRootPath,"App_Data","anka.db");
    await using var db=new SqliteConnection(new SqliteConnectionStringBuilder{DataSource=path,Mode=SqliteOpenMode.ReadWrite}.ToString());
    await db.OpenAsync();
    await using var cmd=new SqliteCommand("SELECT id,title,author,language,original_script,bytes FROM books ORDER BY created_utc DESC",db);
    await using var reader=await cmd.ExecuteReaderAsync();
    while(await reader.ReadAsync())books.Add(new BookListItem(reader.GetString(0),reader.GetString(1),reader.GetString(2),reader.GetString(3),reader.GetString(4),reader.GetInt64(5)));
  }catch(Exception){error="کتابخانه بارگذاری نشد. مجوزهای App_Data را بررسی کنید.";}
 }
}